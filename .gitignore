/target
.claude/

# Test media (binary assets stay out of git)
test_material/*.png
test_material/*.jpg
test_material/*.y4m
test_material/*.y4m.xz
test_material/*.yuv
test_material/*.tiff
test_material/*.exr
test_material/*.dpx
test_material/*.raw
test_material/frames/
# ...and the same path as a symlink: worktrees link it in rather than copying ~GB of frames,
# and a trailing slash matches only a real directory.
test_material/frames

# Web demo media (too large for git)
examples/web/*.gnv
examples/web/*.gnv2
examples/web/*.gnc
examples/web/*.diag
examples/web/*.pem
.aider*

# Python bytecode
__pycache__/
*.pyc

# The metric scripts need numpy and pillow, and the system python here is
# externally managed. One shared venv in the shared checkout, gitignored.
.venv/
examples/web/*.log
examples/web/demos.json

# Pinned measurement inputs. A session copies the frames it measures on into its own worktree so
# another session's refetch cannot change them mid-run (COORDINATION, "record their hashes"). The
# images are test material and stay out of git; the hash list beside them is the record, and does
# not.
frames_pinned/*
!frames_pinned/SHA256SUMS
