#!/usr/bin/env bash
# Atomic claims for concurrent sessions.
#
# The claims table in COORDINATION.md is documentation, not a lock. Reading it, deciding, and
# writing your row are three separate steps, so N sessions that start together all read "free"
# before any of them writes. On 2026-09-07 that sent several sessions at MEAS-9 simultaneously,
# and a duplicate row had to be cleaned up by hand. With eight instances the window is wider,
# not narrower.
#
# This uses the atomic primitive the repository already has. Every worktree shares one .git, so
# `refs/claims/*` is visible to all of them the instant it is written -- no fetch, no daemon, no
# lock file in the tree -- and `git update-ref <ref> <new> <old>` is a compare-and-swap that
# takes git's own ref lock. `<old>` as the empty string means "must not exist", which is exactly
# create-if-absent. Two sessions racing on the same item cannot both win; the loser is told who
# holds it.
#
# Claims are metadata blobs, so `git cat-file -p refs/claims/<ITEM>` shows the owner directly.
# Nothing is pushed: refs/claims stays local to this machine's checkout, which is where the
# contention is.
#
#   scripts/claim take MEAS-9 "cross-codec measurement, no encoder change"
#   scripts/claim list
#   scripts/claim owner MEAS-9
#   scripts/claim touch MEAS-9          # heartbeat, so `list` ages stay honest
#   scripts/claim drop MEAS-9
#   scripts/claim steal MEAS-9 "abandoned, owner's worktree is gone"
#   scripts/claim selftest              # proves the mutual exclusion, 16 racing processes

set -u

usage() { sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

# --- identity: what a claim records. No usernames, no hostnames, no absolute paths --------------
# (CLAUDE.md, "Never commit secrets or local infrastructure detail")

COMMON=$(git rev-parse --git-common-dir 2>/dev/null) || { echo "not a git repository" >&2; exit 2; }
SHARED=$(cd "$(dirname "$COMMON")" && pwd)
here_branch() { git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "detached"; }
here_tree()   { local r; r=$(git rev-parse --show-toplevel); basename "$r"; }
me() { [ -n "${CLAIM_AS:-}" ] && { printf '%s' "$CLAIM_AS"; return; }
       printf '%s@%s' "$(here_tree)" "$(here_branch)"; }

valid_item() {
  case "$1" in
    ""|*[!A-Za-z0-9._-]*) echo "item must match [A-Za-z0-9._-]+ (got '$1')" >&2; return 1 ;;
  esac
  case "$1" in .*|*.lock) echo "item may not start with '.' or end in '.lock'" >&2; return 1 ;; esac
}

ref_of() { printf 'refs/claims/%s' "$1"; }

blob_for() { # item note  -> writes metadata blob, prints sha
  local item=$1 note=${2:-} prev=${3:-}
  { printf 'item:    %s\n' "$item"
    printf 'owner:   %s\n' "$(me)"
    printf 'claimed: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'epoch:   %s\n' "$(date -u +%s)"
    printf 'commit:  %s\n' "$(git rev-parse --short HEAD 2>/dev/null || echo none)"
    [ -n "$note" ] && printf 'note:    %s\n' "$note"
    [ -n "$prev" ] && printf 'taken-from: %s\n' "$prev"
    :
  } | git hash-object -w --stdin
}

field() { git cat-file -p "$1" 2>/dev/null | sed -n "s/^$2: *//p" | head -1; }

age_of() { # blobsha -> human age
  local e now d
  e=$(field "$1" epoch); now=$(date -u +%s)
  [ -z "$e" ] && { echo "?"; return; }
  d=$((now - e))
  if   [ "$d" -lt 90 ];   then echo "${d}s"
  elif [ "$d" -lt 5400 ]; then echo "$((d / 60))m"
  else echo "$((d / 3600))h$(((d % 3600) / 60))m"; fi
}

describe() { # item -> "owner, age, note"
  local sha; sha=$(git rev-parse --quiet --verify "$(ref_of "$1")") || return 1
  printf '%s (held %s' "$(field "$sha" owner)" "$(age_of "$sha")"
  local n; n=$(field "$sha" note); [ -n "$n" ] && printf ', %s' "$n"
  printf ')\n'
}

# --- subcommands --------------------------------------------------------------------------------

cmd_take() {
  local as=""
  if [ "${1:-}" = "--as" ]; then as=${2:-}; shift 2; fi
  local item=${1:-}; shift || true; local note="$*"
  valid_item "$item" || exit 2
  # --as exists to seed the claims that already existed as table rows, and to hand an area over.
  # It is a cooperative tool, not an authorisation boundary: it records who says they own it.
  [ -n "$as" ] && CLAIM_AS=$as
  local sha; sha=$(blob_for "$item" "$note")
  if git update-ref "$(ref_of "$item")" "$sha" "" 2>/dev/null; then
    echo "claimed $item as $(me)"
    return 0
  fi
  echo "REFUSED: $item is already held by $(describe "$item")" >&2
  echo "  pick another item, or 'scripts/claim steal $item \"<why>\"' if that session is gone." >&2
  return 1
}

cmd_drop() {
  local item=${1:-} force=0
  [ "$item" = "--force" ] && { force=1; item=${2:-}; }
  valid_item "$item" || exit 2
  local sha; sha=$(git rev-parse --quiet --verify "$(ref_of "$item")") || {
    echo "$item is not claimed" >&2; return 1; }
  local owner; owner=$(field "$sha" owner)
  if [ "$owner" != "$(me)" ] && [ "$force" -eq 0 ]; then
    echo "REFUSED: $item is held by $owner, not by $(me). Use --force if you mean it." >&2
    return 1
  fi
  # CAS on the value we read: if the owner changed under us, this fails rather than clobbering.
  git update-ref -d "$(ref_of "$item")" "$sha" && echo "released $item"
}

cmd_touch() {
  local item=${1:-}; valid_item "$item" || exit 2
  local sha; sha=$(git rev-parse --quiet --verify "$(ref_of "$item")") || {
    echo "$item is not claimed" >&2; return 1; }
  local owner note; owner=$(field "$sha" owner); note=$(field "$sha" note)
  [ "$owner" = "$(me)" ] || { echo "REFUSED: $item is held by $owner" >&2; return 1; }
  local new; new=$(blob_for "$item" "$note")
  git update-ref "$(ref_of "$item")" "$new" "$sha" && echo "refreshed $item"
}

cmd_steal() {
  local item=${1:-}; shift || true; local why="$*"
  valid_item "$item" || exit 2
  [ -n "$why" ] || { echo "steal needs a reason: scripts/claim steal $item \"<why>\"" >&2; return 2; }
  local sha; sha=$(git rev-parse --quiet --verify "$(ref_of "$item")") || {
    echo "$item is not claimed -- just take it" >&2; return 1; }
  local prev; prev="$(field "$sha" owner) after $(age_of "$sha")"
  local new; new=$(blob_for "$item" "$why" "$prev")
  # CAS: two sessions stealing at once, only one wins.
  git update-ref "$(ref_of "$item")" "$new" "$sha" && echo "took $item from $prev"
}

cmd_owner() {
  local item=${1:-}; valid_item "$item" || exit 2
  describe "$item" || { echo "$item is free"; return 1; }
}

cmd_list() {
  local any=0
  while read -r name sha; do
    [ -z "$name" ] && continue
    any=1
    printf '  %-16s %-28s %6s  %s\n' "$name" "$(field "$sha" owner)" "$(age_of "$sha")" \
      "$(field "$sha" note)"
  done < <(git for-each-ref --format='%(refname:lstrip=2) %(objectname)' refs/claims/)
  [ "$any" -eq 1 ] || echo "  (nothing claimed)"
}

# The canary CLAUDE.md asks for: proof the mutual exclusion is real, not asserted.
cmd_selftest() {
  local item="selftest.$$" n=16 wins=0 out
  out=$(mktemp -d)
  for i in $(seq "$n"); do
    ( "$0" take "$item" "racer $i" >"$out/$i.ok" 2>"$out/$i.err"; echo $? >"$out/$i.rc" ) &
  done
  wait
  for i in $(seq "$n"); do [ "$(cat "$out/$i.rc")" = "0" ] && wins=$((wins + 1)); done
  echo "$n processes raced for one claim; $wins won"
  local rc=0
  [ "$wins" -eq 1 ] || { echo "FAIL: expected exactly 1 winner"; rc=1; }
  # and the loser must be told who holds it, not just refused
  grep -q "already held by" "$out"/*.err || { echo "FAIL: losers were not told the owner"; rc=1; }
  "$0" drop --force "$item" >/dev/null 2>&1
  rm -rf "$out"
  [ "$rc" -eq 0 ] && echo "PASS: claims are atomic"
  return "$rc"
}

case "${1:-}" in
  take|claim)  shift; cmd_take "$@" ;;
  drop|release) shift; cmd_drop "$@" ;;
  touch)       shift; cmd_touch "$@" ;;
  steal)       shift; cmd_steal "$@" ;;
  owner)       shift; cmd_owner "$@" ;;
  list|ls|"")  cmd_list ;;
  selftest)    cmd_selftest ;;
  -h|--help|help) usage 0 ;;
  *) echo "unknown subcommand: $1" >&2; usage 1 ;;
esac
